{
  "name": "markbot",
  "version": "1.0.0",
  "description": "The KAPLAY.js official Discord Bot",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --strict-vars=false",
    "start": "wrangler dev",
    "ngrok": "ngrok http 8787",
    "fix": "eslint --fix '**/*.js'",
    "lint": "eslint '**/*.js'",
    "register": "node --experimental-strip-types src/cli/register.ts",
    "register:prod": "node --experimental-strip-types src/cli/register.ts --prod",
    "clear": "node --experimental-strip-types src/cli/clear.ts",
    "deploy": "wrangler deploy",
    "fmt": "dprint fmt",
    "db:gentypes": "npx supabase gen types typescript --project-id jlhwsrgsgdubxtcgieli --schema public > src/types/database.types.ts"
  },
  "keywords": [],
  "author": "lajbel",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^2.5.0",
    "@supabase/supabase-js": "^2.89.0",
    "discord-api-types": "^0.38.10",
    "discord-interactions": "^4.0.0",
    "dprint": "^0.50.0",
    "itty-router": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@kaplayjs/dprint-config": "^1.2.0",
    "@types/node": "^26.6.5",
    "c8": "^10.1.2",
    "chai": "^5.0.0",
    "dotenv": "^16.0.3",
    "eslint": "^9.1.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^16.0.0",
    "mocha": "^11.0.0",
    "ngrok": "^4.3.3",
    "prettier": "^3.2.5",
    "sinon": "^22.1.0",
    "supabase": "^2.70.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.13.2"
  },
  "allowScripts": {
    "dprint@0.49.1": true,
    "dprint@0.50.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "ngrok@4.3.3": true
  }
}
